  "slots": {
    "headline": "Innovations for maximum protection when handling loads high up",
    "lead-image": "https://www.linde-mh.com/media/Global-Content/03_Solutions_Loesungen/Applications/reach_truck-loading-retail-3958_368_16x9w1920.jpg",
    "intro": "High shelves have become the standard in modern warehouses. Not surprising, given that storage space is precious—and priced accordingly. But working at height with industrial trucks also involves risks, because swaying masts, inaccurate load positioning, and potential collisions with racks can all lead to dangerous situations. Linde Material Handling offers innovative solutions to minimize these risks and other hazards when working at height as well as to ensure the safety of people and transported goods.",
    "hero-slides": [
      "Safe Thanks to Oscillation Control: Dynamic Mast Control",
