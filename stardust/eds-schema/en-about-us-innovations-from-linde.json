    },
    {
     "role": "body",
     "order": 10,
     "text": "Linde’s aisle safety assistant (ASA) helps to reduce damage to the warehouse environment as the forklift truck adapts its movement to its surroundings."
    },
    {
     "role": "cta",
     "order": 11,
     "text": "Learn more",
     "href": "../../../en/About-us/Innovations-from-Linde/Aisle-Safety-Assistant.html"
    }
