    },
    {
     "role": "cta",
     "order": 3,
     "text": "Linde BlueSpot",
     "href": "../../../en/About-us/Innovations-from-Linde/Linde-BlueSpot.html"
    },
    {
     "role": "body",
     "order": 4,
     "text": "The Linde BlueSpot route warning system increases safety in operation, as the LED spot makes trucks silently visible."
    },
    {
     "role": "cta",
     "order": 5,
     "text": "Learn more",
     "href": "../../../en/About-us/Innovations-from-Linde/Linde-BlueSpot.html"
    },
    {
     "role": "cta",
     "order": 6,
     "text": "The Linde TruckSpot",
     "href": "../../../en/About-us/Innovations-from-Linde/TruckSpot.html"
    },
    {
     "role": "body",
     "order": 7,
     "text": "Narrow racking aisles, visually restricted intersections and confusing areas often make it difficult for pedestrians to see a reversing truck in time. The Linde TruckSpot, an optical warning signal solution, uses a light signal to announce that the vehicle is approaching."
    },
    {
     "role": "cta",
     "order": 8,
     "text": "Learn more",
     "href": "../../../en/About-us/Innovations-from-Linde/TruckSpot.html"
    }
   ],
