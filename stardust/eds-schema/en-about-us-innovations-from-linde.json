    {
     "role": "cta",
     "order": 0,
     "text": "Reverse Assist Camera",
     "href": "../../../en/About-us/Innovations-from-Linde/Reverse-Assist-Camera/index.html"
    },
    {
     "role": "body",
     "order": 1,
     "text": "The camera-based assistance system Reverse Assist Camera uses artificial intelligence to warn operators about collisions with pedestrians and reduce the truck speed."
    },
    {
     "role": "cta",
     "order": 2,
     "text": "Learn more",
     "href": "../../../en/About-us/Innovations-from-Linde/Reverse-Assist-Camera/index.html"
    },
    {
     "role": "cta",
     "order": 3,
     "text": "Reverse Assist Radar",
     "href": "../../../en/About-us/Innovations-from-Linde/Reverse-Assist-Radar/index.html"
    },
    {
     "role": "body",
     "order": 4,
     "text": "Reverse Assist Radar from Linde Material Handling is revolutionizing safety when reversing – intelligently, precisely, and effectively."
    },
    {
     "role": "cta",
     "order": 5,
     "text": "Learn more",
     "href": "../../../en/About-us/Innovations-from-Linde/Reverse-Assist-Radar/index.html"
    },
    {
     "role": "cta",
     "order": 6,
     "text": "The Innovative Rack Protection System",
     "href": "../../../en/About-us/Innovations-from-Linde/Rack-Protection-Sensor/index.html"
    },
    {
     "role": "body",
     "order": 7,
     "text": "The Linde Rack Protection Sensor automatically slows down the truck when approaching racks and prevents collisions and damage."
    },
    {
     "role": "cta",
     "order": 8,
     "text": "Learn more",
     "href": "../../../en/About-us/Innovations-from-Linde/Rack-Protection-Sensor/index.html"
    },
    {
     "role": "cta",
     "order": 9,
