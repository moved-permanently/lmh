   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Productivity"
    },
    {
     "role": "body",
     "order": 1,
     "text": "Efficient forklift trucks are the backbone of efficient intra-company logistics. Together with intelligent software and comprehensive service packages, operators achieve lasting competitive advantages."
    },
    {
     "role": "cta",
     "order": 2,
     "text": "More details here",
     "href": "https://www.linde-mh.com/en/Linde-Core/Linde-Productivity.html"
    },
    {
     "role": "heading",
     "order": 3,
     "text": "Safety"
    },
    {
     "role": "body",
     "order": 4,
     "text": "The safety of people, trucks, and goods is the central idea of Linde Material Handling’s Zero Accident Philosophy. With integrated solutions, Linde is working toward a future of safer intralogistics."
    },
    {
     "role": "cta",
     "order": 5,
     "text": "More details here",
     "href": "https://www.linde-mh.com/en/Solutions/Warehouse-Safety/"
    },
    {
     "role": "heading",
     "order": 6,
     "text": "Ergonomics"
    },
    {
     "role": "body",
     "order": 7,
     "text": "The best solutions arise when humans and technology work together in perfect harmony. The principle of ergonomic design therefore strongly informs Linde Material Handling’s development of trucks and services."
    },
    {
     "role": "cta",
     "order": 8,
     "text": "More details here",
     "href": "https://www.linde-mh.com/en/Linde-Core/Linde-Ergonomics.html"
    }
   ],
