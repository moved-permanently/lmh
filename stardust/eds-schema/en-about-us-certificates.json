   "section": "16",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Quality requirements for fusion welding - ISO 3834"
    }
   ],
   "imgCount": 0,
   "editableTexts": 1,
   "repeats": []
  },
  {
   "section": "17",
   "items": [
    {
     "role": "body",
     "order": 0,
     "text": "ISO 3834 defines comprehensive quality requirements for fusion welding of metallic materials both in workshops and at field installation sites."
    }
   ],
   "imgCount": 0,
   "editableTexts": 1,
   "repeats": []
