   "section": "7",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Environmental Management - ISO 14001"
    }
   ],
   "imgCount": 0,
   "editableTexts": 1,
   "repeats": []
  },
  {
   "section": "8",
   "items": [
    {
     "role": "body",
     "order": 0,
     "text": "ISO 14001 sets out the criteria for an Environmental Management System (EMS). The main aim is to assist companies in continually improving their environmental performance, while complying with any applicable legislation."
    }
   ],
   "imgCount": 0,
   "editableTexts": 1,
   "repeats": []
