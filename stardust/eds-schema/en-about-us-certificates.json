   "section": "13",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Energy Management - ISO 50001"
    }
   ],
   "imgCount": 0,
   "editableTexts": 1,
   "repeats": []
  },
  {
   "section": "14",
   "items": [
    {
     "role": "body",
     "order": 0,
     "text": "ISO 50001 is a specification created by the International Organization for Standardization (ISO) for an energy management system. The standard aims to help organizations continually reduce their energy use, and therefore their energy costs and their greenhouse gas emissions."
    }
   ],
   "imgCount": 0,
   "editableTexts": 1,
