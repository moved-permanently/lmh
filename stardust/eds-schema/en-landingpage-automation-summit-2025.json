  {
   "section": "10",
   "items": [
    {
     "role": "body",
     "order": 0,
     "text": "Two days, two powerful networks."
    }
   ],
   "imgCount": 0,
   "editableTexts": 1,
   "repeats": []
  },
  {
   "section": "11",
   "items": [
    {
     "role": "cta",
     "order": 0,
     "text": "Customer Day – November 12, 2025",
     "href": "../../../media/Global-Content/Landingpage-Automation-Summit-2025/LMH_AutomationSummit2025_Agenda_12-11.pdf"
    },
    {
     "role": "body",
     "order": 1,
     "text": "The Customer Day was designed for automation decision-makers (C-Level, Directors, Department Heads, Senior Engineers) from manufacturing and other industries with automation potential."
    },
    {
     "role": "cta",
     "order": 2,
     "text": "See Agenda Customer Day",
     "href": "../../../media/Global-Content/Landingpage-Automation-Summit-2025/LMH_AutomationSummit2025_Agenda_12-11.pdf"
    },
    {
     "role": "cta",
     "order": 3,
     "text": "Press & Consultants Day – November 13, 2025",
     "href": "../../../media/Global-Content/Landingpage-Automation-Summit-2025/LMH_AutomationSummit2025_Agenda_13-11.pdf"
    },
    {
     "role": "body",
     "order": 4,
     "text": "The Press & Consultants Day was exclusively crafted for esteemed key press representatives and intralogistics consultants who shape insights and narratives within our industry."
    },
    {
     "role": "cta",
     "order": 5,
     "text": "See Agenda Press & Consultants Day",
     "href": "../../../media/Global-Content/Landingpage-Automation-Summit-2025/LMH_AutomationSummit2025_Agenda_13-11.pdf"
    }
   ],
